      "name": "Set Campaign Config"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const campaignData = $input.item.json.data[0] ||  {};\nconst timestamp = $('Set Campaign Config').item.json.timestamp;\nconst date = $('Set Campaign Config').item.json.date;\n\n\nreturn{\n    campaign_id: campaignData.campaign_id,\n    campaign_name: campaignData.campaign_name,\n    status:\"ACTIVE\",\n    objective:\"CONVERSIONS\",\n    impressions: parseFloat(campaignData.impressions || 0),\n    clicks: parseFloat(campaignData.clicks || 0),\n    spend: parseFloat(campaignData.spend || 0),\n    cpc: parseFloat(campaignData.cpc || 0),\n    cpm:parseFloat(campaignData.cpm || 0),\n    ctr: parseFloat(campaignData.ctr || 0),\n    reach:parseFloat(campaignData.reach || 0),\n    frequency:parseFloat(campaignData.frequency || 0),\n    conversions:parseFloat(campaignData.conversions || 0),\n       conversion_value:parseFloat(campaignData.conversion_value || 0),\n\n    \n     cost_per_unique_conversion:\n     parseFloat(campaignData.cost_per_unique_conversion || 0),\n roas: parseFloat(\n  campaignData.purchase_roas?.[0]?.value || 0\n),\n     last_updated:timestamp,\n     date: date\n\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -192
      ],
      "id": "37d770b5-12b1-4ce9-81b0-39a7c27a6f6f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const adsetData = $input.item.json.data[0] ||  {};\nconst adsetDetails = $('Split Ad Sets').item.json;\nconst timestamp = $('Set Campaign Config').item.json.timestamp;\nconst date = $('Set Campaign Config').item.json.date;\n\n\nreturn{\n    campaign_id: adsetData.campaign_id,\n    campaign_name: adsetData.campaign_name,\n    adset_id : adsetData.adset_name ||adsetDetails.id,\n    adset_name:adsetData.adset_name || adsetDetails.name,\n    status: adsetDetails.status,\n    impressions: parseFloat(adsetData.impressions || 0),\n    clicks: parseFloat(adsetData.clicks || 0),\n    spend: parseFloat(adsetData.spend || 0),\n    cpc: parseFloat(adsetData.cpc || 0),\n    cpm:parseFloat(adsetData.cpm || 0),\n    ctr: parseFloat(adsetData.ctr || 0),\n    reach:parseFloat(adsetData.reach || 0),\n    frequency:parseFloat(adsetData.frequency || 0),\n    conversions:parseFloat(adsetData.conversions || 0),\n       conversion_value:parseFloat(adsetData.conversion_value || 0),\n\n    \n     cost_per_unique_conversion:\n     parseFloat(adsetData.cost_per_unique_conversion || 0),\n roas: parseFloat(\n  adsetData.purchase_roas?.[0]?.value || 0\n),\n     last_updated:timestamp,\n     date: date\n\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -32
      ],
      "id": "0ff97fe9-b688-44f7-ae65-d68ac49a86cb",
      "name": "Format Ad Set Data"
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n}\n\nreturn $input.all();"
      },
