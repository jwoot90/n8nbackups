    {
      "parameters": {
        "jsCode": "const campaigns = $json.data || [];\nif (!Array.isArray(campaigns) || campaigns.length === 0) return [];\n\nreturn campaigns.map(c => ({\n  ad_account_id: $json.ctx.ad_account_id,\n  report_sheet_url: $json.ctx.report_sheet_url,\n    \nsheet_list: $json.sheet_list,\n  // дата отчёта из Meta\n  report_date: c.date_start,\n\n  // метрики\n  campaign_name: c.campaign_name,\n  spend: Number(c.spend),\n  impressions: Number(c.impressions),\n  clicks: Number(c.clicks),\n  ctr: Number(c.ctr),\n  cpm: Number(c.cpm),\n  cpc: Number(c.cpc),\n\n  date_start: c.date_start,\n  date_stop: c.date_stop,\n}));"
      },
