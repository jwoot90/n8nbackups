        "jsCode": "const url = $json.report_sheet_url;\nif (!url) throw new Error('report_sheet_url пустой');\n\nconst match = url.match(/\\/d\\/([a-zA-Z0-9-_]+)/);\nif (!match) throw new Error('Не нашла spreadsheetId в ссылке');\n\nreturn [{\n  ...$json,\n  report_spreadsheet_id: match[1],\n}];"
      },
